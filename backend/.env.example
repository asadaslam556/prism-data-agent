# Copy to .env and adjust. Everything shown is the default.
# .env is gitignored -- never commit real keys or internal endpoints.

# --- Which LLM answers ---
# ollama (default, fully local) | anthropic | openai
LLM_PROVIDER=ollama
# Override the provider's default model. Empty = qwen2.5 / claude-sonnet-4-6 / gpt-4o-mini.
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT=180
LLM_MAX_TOKENS=2048

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- Hosted providers (only needed if you switch LLM_PROVIDER) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Point at a gateway or any OpenAI-compatible server (LM Studio, vLLM, Groq, ...):
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# --- Agent guardrails ---
# Total planner steps, shared across every parallel branch.
MAX_AGENT_STEPS=16
MAX_SQL_ROWS=1000
SQL_RETRY_ATTEMPTS=1
# Wall-clock cap on one generated snippet, so a runaway loop can't hang a request.
SANDBOX_TIMEOUT_SECONDS=30

# --- Graph shape ---
# How many independent sub-questions may run at once. 1 = classic single loop.
MAX_PARALLEL_BRANCHES=3
# How often the verifier may send the work back for another pass.
MAX_VERIFY_PASSES=1
ENABLE_VERIFIER=true

# --- Server limits ---
MAX_UPLOAD_MB=25
MAX_SESSIONS=24
SESSION_TTL_MINUTES=120
LOG_LEVEL=INFO