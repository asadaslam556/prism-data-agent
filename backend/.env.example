# Copy to .env and adjust. Everything shown is the default.
# .env is gitignored -- never commit real keys or internal endpoints.

# --- Which LLM answers ---
# ollama (default, fully local) | anthropic | openai
LLM_PROVIDER=ollama
# Override the provider's default model. Empty = qwen2.5 / claude-sonnet-4-6 / gpt-4o-mini.
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT=180
LLM_MAX_TOKENS=2048
# Nucleus sampling. Blank = let the provider use its own default.
LLM_TOP_P=
# Raw JSON merged into the request body, for switches the OpenAI schema has no
# field for. Shapes differ per provider and are NOT interchangeable:
#   DeepSeek direct : {"thinking": {"type": "disabled"}}   ("enabled" turns it on)
#   NVIDIA NIM      : {"chat_template_kwargs": {"thinking": true}}
#
# Blank means "send nothing" -- which is NOT the same as non-thinking mode.
# DeepSeek's V4 models think by DEFAULT, and thinking mode rejects a forced
# tool choice, which is exactly what this agent's structured calls (planner,
# decomposer, verifier) use. On DeepSeek, leaving this blank means every
# question fails with "Thinking mode does not support this tool_choice".
# See the DeepSeek block below.
LLM_EXTRA_BODY=

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- Hosted providers (only needed if you switch LLM_PROVIDER) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Point at a gateway or any OpenAI-compatible server (LM Studio, vLLM, Groq, ...):
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
#
# DeepSeek speaks the OpenAI schema, so it goes through the openai provider:
#   LLM_PROVIDER=openai
#   LLM_MODEL=deepseek-v4-flash
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
# That last line is required, not optional -- see the LLM_EXTRA_BODY notes
# above. DeepSeek keys start with sk-, not nvapi-, and the account is prepaid.
# Use the SHORT model name: deepseek-ai/deepseek-v4-flash-0731 is NVIDIA NIM's
# naming and 404s on DeepSeek's own endpoint.
# Use deepseek-v4-flash, not the -vision-exp variant: same price, but it
# is the image-capable experimental build and this agent only sends text.

# --- Agent guardrails ---
# Total planner steps, shared across every parallel branch.
MAX_AGENT_STEPS=16
MAX_SQL_ROWS=1000
SQL_RETRY_ATTEMPTS=1
# Wall-clock cap on one generated snippet, so a runaway loop can't hang a request.
SANDBOX_TIMEOUT_SECONDS=30

# --- Graph shape ---
# How many independent sub-questions may run at once. 1 = classic single loop.
MAX_PARALLEL_BRANCHES=3
# How often the verifier may send the work back for another pass.
MAX_VERIFY_PASSES=1
ENABLE_VERIFIER=true

# --- Access control ---
# Put the whole app behind a browser login prompt. Both blank = no auth, which
# is right on a laptop. Set BOTH on anything with a public URL -- there is no
# other access control, and your API key pays for every question anyone asks.
APP_USERNAME=
APP_PASSWORD=

# --- Deployment ---
# /api/connect dials any SQLAlchemy URL it is given. Leave true locally; the
# Docker image sets it false so a networked deployment can't be used to probe
# whatever it can reach.
ENABLE_DB_CONNECT=true

# --- Server limits ---
MAX_UPLOAD_MB=25
MAX_SESSIONS=24
SESSION_TTL_MINUTES=120
LOG_LEVEL=INFO