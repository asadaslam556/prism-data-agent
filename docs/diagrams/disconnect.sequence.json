{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Closing the tab stops the run",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1000,
      480
    ],
    "output": "disconnect.sequence.html"
  },
  "participants": [
    {
      "id": "browser",
      "type": "frontend",
      "label": "Browser",
      "sublabel": "tab closed mid-answer"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "FastAPI",
      "sublabel": "watch_for_disconnect"
    },
    {
      "id": "graph",
      "type": "backend",
      "label": "Graph thread",
      "sublabel": "BudgetTracker.stop"
    },
    {
      "id": "branch",
      "type": "backend",
      "label": "Branch planner",
      "sublabel": "plan_node"
    }
  ],
  "segments": [
    {
      "from": 145,
      "to": 202,
      "label": "Streaming"
    },
    {
      "from": 215,
      "to": 392,
      "label": "Stop"
    }
  ],
  "messages": [
    {
      "id": "post",
      "from": "browser",
      "to": "api",
      "y": 160,
      "label": "POST /api/query/stream",
      "variant": "emphasis"
    },
    {
      "id": "steps",
      "from": "api",
      "to": "browser",
      "y": 190,
      "label": "event: step …",
      "variant": "dashed"
    },
    {
      "id": "closed",
      "from": "browser",
      "to": "api",
      "y": 230,
      "label": "connection closed",
      "variant": "dashed"
    },
    {
      "id": "stop",
      "from": "api",
      "to": "graph",
      "y": 260,
      "label": "stop.set()",
      "variant": "security"
    },
    {
      "id": "spent",
      "from": "graph",
      "to": "branch",
      "y": 290,
      "label": "budget reads as spent",
      "variant": "security"
    },
    {
      "id": "forced",
      "from": "branch",
      "to": "graph",
      "y": 320,
      "label": "plan forces answer",
      "variant": "return"
    },
    {
      "id": "ends",
      "from": "graph",
      "to": "api",
      "y": 350,
      "label": "run ends, no answer written",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "What stops",
      "items": [
        "The watcher polls request.is_disconnected() every 0.5 s",
        "After stop: plan answers at its next step, verify and interpret skip their model calls"
      ]
    },
    {
      "dot": "slate",
      "title": "What doesn't",
      "items": [
        "A model call already in flight finishes; the thread can't be killed, only told to stop"
      ]
    }
  ]
}
