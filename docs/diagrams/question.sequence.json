{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "A question, end to end",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "output": "question.sequence.html",
    "views": [
      {
        "id": "start",
        "label": "Start",
        "focus": [
          "browser",
          "api",
          "graph",
          "model"
        ],
        "note": "The request starts the graph on its own thread."
      },
      {
        "id": "work",
        "label": "Branch work",
        "focus": [
          "graph",
          "branch",
          "model",
          "data",
          "api",
          "browser"
        ],
        "note": "Branches query the data and stream steps live."
      }
    ],
    "viewBox": [
      1060,
      620
    ]
  },
  "participants": [
    {
      "id": "browser",
      "type": "frontend",
      "label": "Browser",
      "sublabel": "api.js streamQuery"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "FastAPI",
      "sublabel": "query_stream"
    },
    {
      "id": "graph",
      "type": "backend",
      "label": "Graph thread",
      "sublabel": "orchestrator"
    },
    {
      "id": "branch",
      "type": "backend",
      "label": "Branch workers",
      "sublabel": "run in parallel"
    },
    {
      "id": "model",
      "type": "cloud",
      "label": "Model provider",
      "sublabel": "Ollama / OpenAI-compatible"
    },
    {
      "id": "data",
      "type": "database",
      "label": "Dataset",
      "sublabel": "SQLAlchemy engine"
    }
  ],
  "segments": [
    {
      "from": 145,
      "to": 232,
      "label": "Start"
    },
    {
      "from": 235,
      "to": 442,
      "label": "Branches, live"
    },
    {
      "from": 445,
      "to": 532,
      "label": "Check and answer"
    }
  ],
  "messages": [
    {
      "id": "post",
      "from": "browser",
      "to": "api",
      "y": 160,
      "label": "POST /api/query/stream",
      "variant": "emphasis"
    },
    {
      "id": "start-thread",
      "from": "api",
      "to": "graph",
      "y": 190,
      "label": "graph.stream(stop)",
      "variant": "default"
    },
    {
      "id": "decompose",
      "from": "graph",
      "to": "model",
      "y": 220,
      "label": "decompose (model call)",
      "variant": "default"
    },
    {
      "id": "send",
      "from": "graph",
      "to": "branch",
      "y": 250,
      "label": "Send, one per part",
      "variant": "emphasis"
    },
    {
      "id": "plan",
      "from": "branch",
      "to": "model",
      "y": 280,
      "label": "plan · write SQL",
      "variant": "default"
    },
    {
      "id": "sql",
      "from": "branch",
      "to": "data",
      "y": 310,
      "label": "validated SELECT",
      "variant": "security"
    },
    {
      "id": "rows",
      "from": "data",
      "to": "branch",
      "y": 340,
      "label": "rows",
      "variant": "return"
    },
    {
      "id": "step",
      "from": "branch",
      "to": "api",
      "y": 370,
      "label": "step, via queue",
      "variant": "dashed"
    },
    {
      "id": "sse-step",
      "from": "api",
      "to": "browser",
      "y": 400,
      "label": "event: step",
      "variant": "dashed"
    },
    {
      "id": "summary",
      "from": "branch",
      "to": "graph",
      "y": 430,
      "label": "branch summary",
      "variant": "return"
    },
    {
      "id": "verify",
      "from": "graph",
      "to": "model",
      "y": 460,
      "label": "verify · interpret",
      "variant": "default"
    },
    {
      "id": "final",
      "from": "graph",
      "to": "api",
      "y": 490,
      "label": "final state",
      "variant": "return"
    },
    {
      "id": "sse-final",
      "from": "api",
      "to": "browser",
      "y": 520,
      "label": "event: final",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Streaming",
      "items": [
        "Nodes push steps into a queue the moment they finish, so parallel branches report live and interleaved"
      ]
    },
    {
      "dot": "slate",
      "title": "Also",
      "items": [
        "POST /api/query returns the same result in one response, without streaming"
      ]
    }
  ]
}
