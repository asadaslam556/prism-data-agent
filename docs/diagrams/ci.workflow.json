{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How a change lands",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "ci.workflow.html",
    "views": [
      {
        "id": "local",
        "label": "Before the PR",
        "focus": [
          "branch",
          "change",
          "local"
        ],
        "note": "The same checks CI runs, on your machine."
      },
      {
        "id": "ci",
        "label": "On GitHub",
        "focus": [
          "pr",
          "ci",
          "merge",
          "deploy"
        ],
        "note": "Four required checks, then a squash merge."
      }
    ]
  },
  "lanes": [
    {
      "id": "dev",
      "label": "Your machine"
    },
    {
      "id": "gh",
      "label": "GitHub"
    },
    {
      "id": "render",
      "label": "Render"
    }
  ],
  "mainPath": [
    "branch",
    "change",
    "local",
    "pr",
    "ci",
    "merge",
    "deploy"
  ],
  "nodes": [
    {
      "id": "branch",
      "lane": "dev",
      "col": 0,
      "type": "external",
      "label": "Branch off main",
      "width": 150
    },
    {
      "id": "change",
      "lane": "dev",
      "col": 1,
      "type": "backend",
      "label": "Change + tests",
      "sublabel": "CHANGELOG if user-visible",
      "width": 150
    },
    {
      "id": "local",
      "lane": "dev",
      "col": 2,
      "type": "security",
      "label": "Local checks",
      "sublabel": "ruff · pytest",
      "tag": "npm run build",
      "width": 150
    },
    {
      "id": "pr",
      "lane": "gh",
      "col": 3,
      "type": "frontend",
      "label": "Pull request",
      "sublabel": "into main",
      "width": 150
    },
    {
      "id": "ci",
      "lane": "gh",
      "col": 4,
      "type": "security",
      "label": "CI",
      "sublabel": "backend 3.11 · 3.12",
      "tag": "frontend · image",
      "width": 150
    },
    {
      "id": "merge",
      "lane": "gh",
      "col": 5,
      "type": "backend",
      "label": "Squash merge",
      "sublabel": "4 checks required",
      "width": 150
    },
    {
      "id": "deploy",
      "lane": "render",
      "col": 5,
      "type": "cloud",
      "label": "Redeploy",
      "sublabel": "auto on push to main",
      "tag": "Render setting",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "branch-change",
      "from": "branch",
      "to": "change",
      "variant": "emphasis"
    },
    {
      "id": "change-local",
      "from": "change",
      "to": "local",
      "variant": "emphasis"
    },
    {
      "id": "local-pr",
      "from": "local",
      "to": "pr",
      "label": "push",
      "variant": "emphasis"
    },
    {
      "id": "pr-ci",
      "from": "pr",
      "to": "ci",
      "variant": "emphasis"
    },
    {
      "id": "ci-merge",
      "from": "ci",
      "to": "merge",
      "label": "all green",
      "variant": "emphasis"
    },
    {
      "id": "merge-deploy",
      "from": "merge",
      "to": "deploy",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "CI jobs (.github/workflows/ci.yml)",
      "items": [
        "backend: ruff check and pytest on Python 3.11 and 3.12",
        "frontend: npm ci and npm run build · image: docker build"
      ]
    },
    {
      "dot": "slate",
      "title": "Also running",
      "items": [
        "CodeQL code scanning (GitHub default setup, not a required check)",
        "Dependabot opens grouped update PRs monthly"
      ]
    }
  ]
}
