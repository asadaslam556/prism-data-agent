{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Lifecycle of one question",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      640
    ],
    "output": "agent-run.lifecycle.html",
    "views": [
      {
        "id": "normal",
        "label": "Answered",
        "focus": [
          "started",
          "decompose",
          "branches",
          "verify",
          "answered"
        ],
        "note": "The usual path, with at most MAX_VERIFY_PASSES retries."
      },
      {
        "id": "exits",
        "label": "Other endings",
        "focus": [
          "branches",
          "stopping",
          "failed",
          "stopped"
        ],
        "note": "A model outage, or the client leaving."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Run"
    },
    {
      "id": "events",
      "label": "Interruptions"
    },
    {
      "id": "terminal",
      "label": "Endings"
    }
  ],
  "states": [
    {
      "id": "started",
      "type": "start",
      "label": "Started",
      "sublabel": "graph thread running",
      "lane": "main",
      "col": 0
    },
    {
      "id": "decompose",
      "type": "active",
      "label": "Decomposing",
      "sublabel": "split the question",
      "lane": "main",
      "col": 1
    },
    {
      "id": "branches",
      "type": "active",
      "label": "Branches running",
      "sublabel": "plan · query · chart",
      "lane": "main",
      "col": 2,
      "tag": "steps stream live"
    },
    {
      "id": "verify",
      "type": "decision",
      "label": "Verifying",
      "sublabel": "enough to answer?",
      "lane": "main",
      "col": 3
    },
    {
      "id": "answered",
      "type": "success",
      "label": "Answered",
      "sublabel": "event: final",
      "lane": "main",
      "col": 4
    },
    {
      "id": "stopping",
      "type": "waiting",
      "label": "Stopping",
      "sublabel": "stop is set",
      "lane": "events",
      "col": 1,
      "tag": "no new model calls"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "readable error",
      "lane": "terminal",
      "col": 0,
      "tag": "in the final event"
    },
    {
      "id": "stopped",
      "type": "neutral",
      "label": "Stopped",
      "sublabel": "no answer written",
      "lane": "terminal",
      "col": 1
    }
  ],
  "transitions": [
    {
      "id": "start-decompose",
      "from": "started",
      "to": "decompose",
      "variant": "emphasis"
    },
    {
      "id": "decompose-branches",
      "from": "decompose",
      "to": "branches",
      "variant": "emphasis"
    },
    {
      "id": "branches-verify",
      "from": "branches",
      "to": "verify",
      "variant": "emphasis"
    },
    {
      "id": "verify-answered",
      "from": "verify",
      "to": "answered",
      "label": "ok",
      "variant": "emphasis"
    },
    {
      "id": "verify-retry",
      "from": "verify",
      "to": "decompose",
      "label": "gap found",
      "variant": "dashed",
      "route": "top-channel"
    },
    {
      "id": "branches-stopping",
      "from": "branches",
      "to": "stopping",
      "label": "client left",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "stopping-stopped",
      "from": "stopping",
      "to": "stopped",
      "variant": "security"
    },
    {
      "id": "branches-failed",
      "from": "branches",
      "to": "failed",
      "label": "ProviderError",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 150
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Failed",
      "items": [
        "Any model call can raise ProviderError (outage, bad key, rejected request); a vanished session does the same"
      ]
    },
    {
      "dot": "slate",
      "title": "Also",
      "items": [
        "An unexpected bug ends the stream with event: error instead of final"
      ]
    }
  ]
}
